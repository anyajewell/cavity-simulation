function [laser, outputs, sim, gain_medium] = L_3D(consts, sim, laser, frame, mirror, outputs, toggles, gain_medium)

while laser.pos > mirror(2).loc
    frame.Omega = frame.Omega; % opportunity to read/update Omega from other code
    frame.accel = frame.accel; % opportunity to read/update accel from other code
    if laser.pos + sim.dz < mirror(2).loc % beam will step past mirror
        dz_step = mirror(2).loc - laser.pos; % calculate fractional step
        if dz_step == 0 % beam will step directly to mirror 2
            if toggles.track_centers == true && toggles.outputs_switch == true
                outputs.centerx(end+1) = trapz(trapz(sim.X.*abs(laser.Gau).^2))/trapz(trapz(abs(laser.Gau).^2)); % track center x
                outputs.centery(end+1) = trapz(trapz(sim.Y.*abs(laser.Gau).^2))/trapz(trapz(abs(laser.Gau).^2)); % track center y
            end
            break
        else % propagate by fractional step to mirror 2
            [laser, outputs] = Prop(consts, sim, laser, frame, outputs, toggles, dz_step); % propagate fractional step to mirror
            laser.pos = laser.pos + dz_step; % update laser position
        end
    else % propagate by dz, as normal
        [laser, outputs] = Prop(consts, sim, laser, frame, outputs, toggles, sim.dz); % propagation loop
        laser.pos = laser.pos + sim.dz; % update laser position
    end
end

% Interact with mirror 2 (LHS)
RP_before = trapz(trapz(abs(laser.Gau).^2)); % power before mirror 2
I_before = 0.5*consts.c*consts.eps0*abs(laser.Gau).^2; % intensity before mirror 2
theta_x2 = 0; theta_y2 = 0; % query mirror misalignment
phi_tilt2 = 2*laser.k0*(theta_x2*sim.X + theta_y2*sim.Y);
mirror(2).tmask = exp(1i*phi_tilt2); % tilt mask
laser.Gau = laser.Gau.*mirror(2).cmask.*mirror(2).rmask.*mirror(2).tmask; % clip and shape the beam
RP_after = trapz(trapz(abs(laser.Gau).^2)); % power after mirror 2
I_after = 0.5*consts.c*consts.eps0*abs(laser.Gau).^2; % intensity after mirror 2

if toggles.outputs_switch == true
    outputs.R2(end+1) = RP_after / RP_before; % reflected over incident power
    outputs.loss2(end+1) =  1 - RP_after / RP_before;
    outputs.Imax(end+1) = max(I_after,[],'all');
end

[sim] = Turn_Around(sim);

end

function [EminusNext, EplusAtLHS, outputs] = ...
    L_3D(consts, sim, laser, frame, mirror, outputs, toggles)

Nz = sim.Nz;
mirror(2) = mirror(2);
Eminus = laser.Eminus;
EminusNext = zeros(size(Eminus), 'like', Eminus);

slice = struct('Ld', laser.Ld, 'k0', laser.k0, ...
    'Gau', [], 'pos', []);

% Record diagnostics at the mirror plane.
propToggles = toggles;
propToggles.outputs_switch = false;

% Advance interior slices one cell to the left.
for j = 2:Nz
    slice.Gau = Eminus(:,:,j);
    slice.pos = sim.z(j);
    slice = Prop(consts, sim, slice, frame, struct(), ...
        propToggles, -sim.dz);

    EminusNext(:,:,j-1) = slice.Gau;
end

% Travel from the first cell center to the LHS mirror.
incidentToggles = propToggles;

slice.Gau = Eminus(:,:,1);
slice.pos = sim.z(1);
dzToMirror = mirror(2).loc - slice.pos;
slice = Prop(consts, sim, slice, frame, struct(), ...
    incidentToggles, dzToMirror);
E_incident = slice.Gau;

% Interact with mirror 2
phi_tilt = 2*laser.k0*(mirror(2).dtheta_x*sim.X + mirror(2).dtheta_y*sim.Y);
tilt_mask = exp(1i*phi_tilt);
E_reflected = E_incident .* mirror(2).cmask .* mirror(2).rmask .* tilt_mask;

if toggles.outputs_switch
    pixel_area = sim.dx*sim.dy;
    RP_before = pixel_area*sum(abs(E_incident).^2, 'all');
    RP_after = pixel_area*sum(abs(E_reflected).^2, 'all');

    reflectance = NaN;
    if RP_before > 0
        reflectance = RP_after/RP_before;
    end

    outputs.R2(end+1) = reflectance;
    outputs.loss2(end+1) = 1 - reflectance;
    outputs.Imax(end+1) = 0.5*consts.c*consts.eps0 ...
        * max(abs(E_reflected).^2, [], 'all');
end

% Return to the first cell center as a right-going field.
slice.Gau = E_reflected;
slice.pos = mirror(2).loc;
dzFromMirror = sim.z(1) - slice.pos;
slice = Prop(consts, sim, slice, frame, struct(), ...
    propToggles, dzFromMirror);

EplusAtLHS = slice.Gau;
end