clear; close all

% Inputs

%
hnu_p = h*c/lambda_p;  hnu_L = h*c/lambda_L;  E_f = h*c/lambda_f;
sigma = alpha/N;                                  % pump cross section; [C] writes alpha = sigma*N
z_R   = n_p*pi*w0^2/(lambda_p*M2_p);              % (1) [S] Eq. 21
wz    = @(z) w0*sqrt(1 + ((z - z_w)/z_R).^2);     % (1) [S] Eq. 20
u_L   = @(r) 2/(pi*w_L^2)*exp(-2*r.^2/w_L^2);     % TEM00 mode, normalized so its area integral is 1
loss  = -log(1 - T_oc) - log(1 - L_i);            % (5) round-trip loss

% (2) solved for N2 (DERIVED). With s = sigma*I/hnu_p and g = sigma_L*I_L/hnu_L, (2) and N1 = N - N2 give
%     W_up*N2^2 + B*N2 - s*N = 0,  B = 1/tau_f + s + g.
% Positive root, multiplied through by its conjugate so it stays accurate as W_up -> 0:
B     = @(I, IL) 1/tau_f + sigma*I/hnu_p + sigma_L*IL/hnu_L;
N2fun = @(I, IL) 2*(sigma*I/hnu_p)*N ./ (B(I,IL) + sqrt(B(I,IL).^2 + 4*W_up*(sigma*I/hnu_p)*N));

% Grid in beam coordinates: rho = r/w(z) is constant along each ray of the expanding beam.
% rho up to R/w0 covers the whole crystal at every z, because w(z) >= w0.
rho = linspace(0, R/w0, 201)';  zg = linspace(0, L, 1001);
p = struct(rho=rho, zg=zg, wz=wz, P=P, sigma=sigma, N=N, N2fun=N2fun, u_L=u_L, sigma_L=sigma_L);

P_circ = 0;
if lasing
    % (5): find the one-way circulating power at which the round-trip gain equals the loss.
    gain0 = pump(0, p);
    if gain0 <= loss
        fprintf("Below threshold (round-trip gain %.4f <= loss %.4f): running non-lasing.\n", gain0, loss);
        lasing = false;
    else
        Pc_hi = P/T_oc;
        while pump(Pc_hi, p) > loss, Pc_hi = 2*Pc_hi; end
        P_circ = fzero(@(Pc) pump(Pc, p) - loss, [0 Pc_hi], optimset(TolX=1e-4));
    end
end
P_out = T_oc*P_circ;
[~, F, N2g, Ig, ILg] = pump(P_circ, p);

Qg = sigma*(N - N2g).*Ig - (N2g/tau_rad)*E_f - sigma_L*ILg.*N2g;   % (4), W/m^3 on the (rho, z) grid

% Power bookkeeping (volume integrals over the grid)
dA     = 2*pi*wz(zg).^2.*rho;                         % ring area per unit rho at each z
vint   = @(f) trapz(zg, trapz(rho, f.*dA, 1));
P_abs  = vint(sigma*(N - N2g).*Ig);                   % absorbed pump
P_tr   = 2*pi*wz(L)^2*trapz(rho, (wz(0)/wz(L))^2*F(:,end).*rho);   % pump leaving the back face
P_stim = vint(sigma_L*ILg.*N2g);                      % into the laser mode
P_heat = vint(Qg);                                    % heat

% Heat source for the FE model, interpolated from the grid
Qint = griddedInterpolant({rho, zg}, Qg, "linear", "nearest");
Qfun = @(x, y, z) Qint(sqrt(x.^2 + y.^2)./wz(z), z);

fprintf("Pump: w(0) = %.3f mm, waist %.3f mm at z = %.2f mm, w(L) = %.3f mm | absorbed %.3f W + transmitted %.3f W = %.3f of %.2f W\n", ...
        wz(0)*1e3, w0*1e3, z_w*1e3, wz(L)*1e3, P_abs, P_tr, P_abs + P_tr, P);
if lasing
    fprintf("Laser: P_out = %.3f W (T_oc %.2f, L_i %.2f, w_L %.3f mm) | into mode %.3f W vs P_circ*loss %.3f W\n", ...
            P_out, T_oc, L_i, w_L*1e3, P_stim, P_circ*loss);
else
    fprintf("Laser: off (non-lasing)\n");
end
fprintf("Heat: %.3f W (fraction of absorbed %.3f) | N2/N at pump-face center %.4f\n", ...
        P_heat, P_heat/P_abs, N2g(1,1)/N);

%% ---------------- Geometry ----------------
% Cross-section: trapezoid (P1) + contact-layer circle (C2) + crystal circle (C1), extruded along z
xt = [-W_top/2,  W_top/2,  W_bot/2, -W_bot/2];
yt = [ H_blk/2,  H_blk/2, -H_blk/2, -H_blk/2];
gd = zeros(10, 3);
gd(:,1)   = [2; 4; xt(:); yt(:)];
gd(1:4,2) = [1; 0; 0; R + t_c];
gd(1:4,3) = [1; 0; 0; R];
g = extrude(fegeometry(decsg(gd, 'P1+C2+C1', char('P1', 'C2', 'C1')')), L);

% Cells and faces are numbered by the toolbox, so find them by location
f_front_cry = nearestFace(g, [0 0 0]);
f_front_lay = nearestFace(g, [R + t_c/2, 0, 0]);
f_top       = nearestFace(g, [0, H_blk/2, L/2]);
for k = 1:g.NumCells
    cf = cellFaces(g, k);
    if any(cf == f_front_cry), cell_cry = k;
    elseif any(cf == f_front_lay), cell_lay = k;
    else, cell_cu = k;
    end
end

%% ---------------- Thermal model ----------------
model = femodel(AnalysisType="thermalSteady", Geometry=g);
kfun  = @(loc, state) [kc; ka; ka] .* (T_ref ./ (state.u + 273.15)).^n_k(:);   % (6) [K] Eq. 1, per axis
model.MaterialProperties(cell_cry) = materialProperties(ThermalConductivity=kfun);
model.MaterialProperties(cell_lay) = materialProperties(ThermalConductivity=h_c*t_c);
model.MaterialProperties(cell_cu)  = materialProperties(ThermalConductivity=k_cu);
model.CellLoad(cell_cry) = cellLoad(Heat=@(loc, state) Qfun(loc.x, loc.y, loc.z));       % (4) in crystal only
model.FaceBC(f_top) = faceBC(Temperature=T0);                                            % chiller
model.CellIC = cellIC(Temperature=T0);

% Mesh: fine in the crystal and contact layer (heat sits within ~1/alpha and w0), coarse in copper.
% Same settings as the converged 22 Oct mesh study.
f_fine = unique([cellFaces(g, cell_cry), cellFaces(g, cell_lay)]);
model  = generateMesh(model, Hmax=1.0e-3, Hface={f_fine, min(w0, 1/alpha)/3}, Hgrad=1.4);
fprintf("Mesh: %d nodes\n", size(model.Geometry.Mesh.Nodes, 2));

result = solve(model);

%% ---------------- Results ----------------
% Crystal temperature on a regular grid (NaN outside the crystal), saved for the wavefront step
nx = 81;  nz = 61;                       % odd, so x = 0 and y = 0 are grid lines
xg = linspace(-R, R, nx);  zs = linspace(0, L, nz);
[X3, Y3, Z3] = ndgrid(xg, xg, zs);       % dims: (x, y, z)
in = X3.^2 + Y3.^2 <= R^2;
T3 = nan(size(X3));
T3(in) = interpolateTemperature(result, [X3(in)'; Y3(in)'; Z3(in)']);
dT3 = T3 - T0;
dn3 = dne_dT*dT3;                        % (7)
mid = (nx + 1)/2;
dT_pk = interpolateTemperature(result, [0; 0; 0]) - T0;

% Heat leaving through the chiller: integrate -k_cu dT/dy over a plane just under the chiller face
% (evaluateHeatRate returns 0 for this multi-material k(T) model)
y1 = H_blk/2 - 0.2e-3;  y2 = H_blk/2 - 0.1e-3;
hw = W_bot/2 + (y1 + H_blk/2)/H_blk*(W_top - W_bot)/2;
[Xq, Zq] = meshgrid(linspace(-0.999*hw, 0.999*hw, 200), linspace(0, L, 100));
Tq1 = interpolateTemperature(result, [Xq(:)'; y1*ones(1, numel(Xq)); Zq(:)']);
Tq2 = interpolateTemperature(result, [Xq(:)'; y2*ones(1, numel(Xq)); Zq(:)']);
Q_out = trapz(Zq(:,1), trapz(Xq(1,:), reshape(-k_cu*(Tq2 - Tq1)/(y2 - y1), size(Xq)), 2));

fprintf("Peak dT = %.2f K (pump-face center) | heat in %.3f W, out through chiller %.3f W (balance %.2f%%)\n", ...
        dT_pk, P_heat, Q_out, 100*(P_heat - Q_out)/P_heat);
fprintf("Peak dn = %.3e (dn_e/dT = %.2e /K)\n", dne_dT*dT_pk, dne_dT);

save("Copper_results.mat", "xg", "zs", "T3", "T0", "dne_dT", "R", "L", "lambda_L", ...
     "lasing", "P", "P_out", "P_heat", "kc", "ka", "n_k");

%% ---------------- Plots ----------------
% Mount cross-section at the pump face
nb = 201;
[XB, YB] = meshgrid(linspace(-W_top/2, W_top/2, nb), linspace(-H_blk/2, H_blk/2, nb));
TB = reshape(interpolateTemperature(result, [XB(:)'; YB(:)'; zeros(1, nb^2)]), size(XB));
th = linspace(0, 2*pi, 200);

figure(Name="Temperature", Units="normalized", Position=[0.03 0.2 0.94 0.5]);
tiledlayout(1, 4, TileSpacing="compact", Padding="compact");
nexttile
imagesc(XB(1,:)*1e3, YB(:,1)*1e3, TB - T0, AlphaData=~isnan(TB)); axis xy equal tight; colorbar
hold on; plot(R*1e3*cos(th), R*1e3*sin(th), "w"); hold off
xlabel("x, c-axis (mm)"); ylabel("y (mm), chiller on top"); title("Mount at z = 0, \DeltaT (K)")
nexttile
imagesc(xg*1e3, xg*1e3, dT3(:,:,1)', AlphaData=~isnan(dT3(:,:,1)')); axis xy equal tight; colorbar
xlabel("x, c-axis (mm)"); ylabel("y, a-axis (mm)"); title("Crystal pump face, \DeltaT (K)")
nexttile
imagesc(zs*1e3, xg*1e3, squeeze(dT3(:,mid,:))); axis xy tight; colorbar
xlabel("z (mm)"); ylabel("x, c-axis (mm)"); title("Slice along c (y = 0), \DeltaT (K)")
nexttile
imagesc(zs*1e3, xg*1e3, squeeze(dT3(mid,:,:))); axis xy tight; colorbar
xlabel("z (mm)"); ylabel("y, a-axis (mm)"); title("Slice along a (x = 0), \DeltaT (K)")

figure(Name="Refractive index change", Units="normalized", Position=[0.1 0.15 0.8 0.45]);
tiledlayout(1, 3, TileSpacing="compact", Padding="compact");
nexttile
imagesc(xg*1e3, xg*1e3, dn3(:,:,1)'*1e4, AlphaData=~isnan(dn3(:,:,1)')); axis xy equal tight; colorbar
xlabel("x, c-axis (mm)"); ylabel("y, a-axis (mm)"); title("\Deltan at pump face (\times10^{-4})")
nexttile
imagesc(zs*1e3, xg*1e3, squeeze(dn3(:,mid,:))*1e4); axis xy tight; colorbar
xlabel("z (mm)"); ylabel("x, c-axis (mm)"); title("\Deltan along c, y = 0 (\times10^{-4})")
nexttile
imagesc(zs*1e3, xg*1e3, squeeze(dn3(mid,:,:))*1e4); axis xy tight; colorbar
xlabel("z (mm)"); ylabel("y, a-axis (mm)"); title("\Deltan along a, x = 0 (\times10^{-4})")

%% ================= Local function =================
function [gain, F, N2, I, IL] = pump(P_circ, p)
% Propagates the pump through the crystal with the laser field present and returns the round-trip
% gain of the laser mode, (5).
% Along each ray (fixed rho), F obeys (3): dF/dz = -sigma*(N - N2)*F. The intensity is
% I = (w(0)/w(z))^2 * F, so the power between two rays changes only by absorption (DERIVED from the
% 1/w^2 peak scaling of a Gaussian beam). F(rho, 0) = 2P/(pi w(0)^2) exp(-2 rho^2) carries power P.
rho = p.rho;  zg = p.zg;  dz = zg(2) - zg(1);
w_0 = p.wz(0);
IL_at = @(z) 2*P_circ*p.u_L(rho*p.wz(z));                 % forward + backward laser intensity
dFdz  = @(z, Fk) -p.sigma*(p.N - p.N2fun((w_0/p.wz(z))^2*Fk, IL_at(z))).*Fk;
F = zeros(numel(rho), numel(zg));
F(:,1) = 2*p.P/(pi*w_0^2)*exp(-2*rho.^2);
for k = 1:numel(zg) - 1                                   % RK4 in z
    z = zg(k);  Fk = F(:,k);
    k1 = dFdz(z, Fk);
    k2 = dFdz(z + dz/2, Fk + dz/2*k1);
    k3 = dFdz(z + dz/2, Fk + dz/2*k2);
    k4 = dFdz(z + dz,   Fk + dz*k3);
    F(:,k+1) = Fk + dz/6*(k1 + 2*k2 + 2*k3 + k4);
end
wzg = p.wz(zg);
I   = (w_0./wzg).^2.*F;
IL  = 2*P_circ*p.u_L(rho.*wzg);
N2  = p.N2fun(I, IL);
gain = 2*trapz(zg, trapz(rho, p.sigma_L*N2.*p.u_L(rho.*wzg).*(2*pi*wzg.^2.*rho), 1));
end
